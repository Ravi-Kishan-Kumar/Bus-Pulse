# Local compose
POSTGRES_DB=ridesense
POSTGRES_USER=ridesense
# Required local-only credentials. Set non-empty, unique values in .env.
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false

# Simulation
SEED=42
SIM_SPEEDUP=1
SIM_START_LOCAL=now
DEMAND_SCALE=1.0
MAX_SIM_BUSES=4000
BEAT_S=30
BUS_LIVE_TTL_SECONDS=75

# Streaming
WINDOW_SECONDS=60
ALLOWED_LATENESS_SECONDS=15
OVERCROWD_THRESHOLD_PCT=85
SPARK_MASTER=local[4]
SPARK_SHUFFLE_PARTITIONS=3
TRIGGER_INTERVAL=1 second
CHECKPOINT_DIR=/app/checkpoints/live-v2
# Keep local Kafka storage bounded. Increase these only when longer replay
# history is required for debugging or evaluation.
KAFKA_LOG_RETENTION_HOURS=1
KAFKA_TOPIC_RETENTION_MS=3600000

# Agent provider: mock works with no key; groq is the recommended live provider.
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=15
